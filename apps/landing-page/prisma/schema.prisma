// SuberFood Monolithic Database Schema
// Comprehensive schema covering IAM, Distribution, Restaurants, Processing, Farming

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "darwin"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// IDENTITY & ACCESS MANAGEMENT (IAM)
// ========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN

  // Distribution Roles
  DISTRIBUTION_MANAGER
  RESTAURANT_MANAGER
  RESTAURANT_STAFF
  RETAIL_MANAGER
  PARTNER_MANAGER

  // Processing Roles
  PROCESSING_MANAGER
  QUALITY_CONTROL

  // Farming Roles
  FARM_MANAGER
  FARM_WORKER

  // Customer Roles
  CUSTOMER
  B2B_PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String? // Made optional for OAuth users
  firstName     String? // Made optional for OAuth
  lastName      String? // Made optional for OAuth
  name          String? // Full name for OAuth
  phone         String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE) // Changed default to ACTIVE for easier onboarding
  emailVerified DateTime?
  image         String?

  // Phase 1: Customer preferences
  favoriteMenuItems   String[] // Menu item IDs
  dietaryRestrictions String[] // vegetarian, vegan, keto, etc.
  allergies           String[] // gluten, dairy, nuts, shellfish, etc.
  birthdate           DateTime?
  communicationPrefs  Json? // Email, SMS preferences

  // Phase 2: Enhanced tracking
  lastLoginAt         DateTime?
  loginCount          Int       @default(0)
  preferredRestaurant String? // Restaurant ID
  lifetimeValue       Float     @default(0) // Total spending
  pointsBalance       Int       @default(0) // Loyalty points

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions     Session[]
  accounts     Account[]
  orders       Order[]
  reservations Reservation[]
  addresses    Address[]
  cart         CartItem[]
  reviews      Review[]
  orderHistory UserOrderHistory[]
  staff        Staff? // One-to-one: User can be a staff member

  // Farm Products Relations
  farmCarts           FarmCart[]
  farmOrders          FarmOrder[]
  farmProductReviews  FarmProductReview[]

  // NEW: Wallet System
  wallet                  Wallet?
  paymentTransactions     PaymentTransaction[]

  // NEW: Referral System
  referralCode            ReferralCode?
  verification            UserVerification?
  myReferrals             Referral[]       @relation("UserReferrals")
  referredByRelation      Referral?        @relation("UserReferredBy")
  referredOrders          FarmOrder[]      @relation("ReferredOrders")

  // NEW: Customer Reliability & Red Flags
  reliability             CustomerReliability?
  redFlagIncidents        RedFlagIncident[]

  @@map("users")
}

// Account model for OAuth providers
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

// Verification tokens for email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User order history for personalization
model UserOrderHistory {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String? // If restaurant order
  productId  String? // If retail order
  orderId    String
  quantity   Int      @default(1)
  orderedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([menuItemId])
  @@map("user_order_history")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  type       String // BILLING, SHIPPING, BOTH
  street     String
  city       String
  state      String
  postalCode String
  country    String  @default("USA")
  isDefault  Boolean @default(false)

  // GPS Coordinates for delivery location
  latitude   Float?
  longitude  Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// ========================================
// WALLET SYSTEM
// ========================================

model Wallet {
  id                      String              @id @default(cuid())
  userId                  String              @unique
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Balances
  balance                 Decimal             @default(0) @db.Decimal(12, 2)
  totalDeposits           Decimal             @default(0) @db.Decimal(12, 2)
  totalWithdrawals        Decimal             @default(0) @db.Decimal(12, 2)
  totalSpent              Decimal             @default(0) @db.Decimal(12, 2)
  totalReferralEarnings   Decimal             @default(0) @db.Decimal(12, 2)

  // Relationships
  transactions            WalletTransaction[]
  withdrawalRequests      WithdrawalRequest[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([userId])
  @@map("wallets")
}

enum WalletTransactionType {
  DEPOSIT              // Customer adds money
  WITHDRAWAL           // Customer withdraws money
  PURCHASE             // Payment for order
  REFUND               // Order cancelled/overpayment
  REFERRAL_EARNING     // Commission from referral
  ADMIN_ADJUSTMENT     // Manual admin correction
}

model WalletTransaction {
  id                String                 @id @default(cuid())
  walletId          String
  wallet            Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type              WalletTransactionType
  amount            Decimal                @db.Decimal(12, 2)
  balanceBefore     Decimal                @db.Decimal(12, 2)
  balanceAfter      Decimal                @db.Decimal(12, 2)

  // Reference tracking
  referenceType     String?                // "ORDER", "REFERRAL", "WITHDRAWAL", "DEPOSIT"
  referenceId       String?                // ID of the related entity

  description       String
  metadata          Json?                  // Flexible field for extra data

  createdBy         String?
  createdAt         DateTime               @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model WithdrawalRequest {
  id                String            @id @default(cuid())
  walletId          String
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount            Decimal           @db.Decimal(12, 2)
  method            String            // "CASH", "MTN_MOMO", "ORANGE_MOMO", "BANK_TRANSFER"

  // Customer details for withdrawal
  phoneNumber       String?
  accountDetails    Json?             // Bank account, MoMo name, etc.

  status            WithdrawalStatus  @default(PENDING)

  // Admin handling
  reviewedBy        String?
  reviewedAt        DateTime?
  adminNotes        String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([walletId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

// ========================================
// REFERRAL SYSTEM
// ========================================

model ReferralCode {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  code                  String              @unique // e.g., "JOHN2024"
  isActive              Boolean             @default(true)
  isSuspended           Boolean             @default(false)
  suspensionReason      String?

  // Verification status
  isVerified            Boolean             @default(false)
  verification          UserVerification?

  // Stats
  totalReferrals        Int                 @default(0)
  activeReferrals       Int                 @default(0) // Customers who made at least 1 order
  totalEarnings         Decimal             @default(0) @db.Decimal(12, 2)
  lifetimeEarnings      Decimal             @default(0) @db.Decimal(12, 2)

  // Relationships
  referrals             Referral[]          @relation("ReferrerReferrals")
  earnings              ReferralEarning[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([code])
  @@index([userId])
  @@map("referral_codes")
}

enum ReferralStatus {
  PENDING      // Referee signed up but no order yet
  ACTIVE       // Referee made at least one order
  INACTIVE     // Referee account suspended/deleted
}

model Referral {
  id                String            @id @default(cuid())

  // Referrer (person who referred)
  referrerId        String
  referrer          User              @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referralCodeId    String
  referralCode      ReferralCode      @relation("ReferrerReferrals", fields: [referralCodeId], references: [id])

  // Referee (person who was referred)
  refereeId         String            @unique
  referee           User              @relation("UserReferredBy", fields: [refereeId], references: [id], onDelete: Cascade)

  status            ReferralStatus    @default(PENDING)

  // Stats
  totalOrders       Int               @default(0)
  totalEarned       Decimal           @default(0) @db.Decimal(12, 2)

  // Relationships
  earnings          ReferralEarning[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([referrerId])
  @@index([refereeId])
  @@index([referralCodeId])
  @@map("referrals")
}

model ReferralEarning {
  id                  String         @id @default(cuid())

  referralId          String
  referral            Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)

  referralCodeId      String
  referralCode        ReferralCode   @relation(fields: [referralCodeId], references: [id])

  orderId             String
  order               FarmOrder      @relation(fields: [orderId], references: [id])

  // Financial breakdown
  orderTotal          Decimal        @db.Decimal(12, 2)
  orderCost           Decimal        @db.Decimal(12, 2)  // What you paid farmers + transport
  profitAmount        Decimal        @db.Decimal(12, 2)  // orderTotal - orderCost
  commissionRate      Decimal        @default(50) @db.Decimal(5, 2) // 50% by default
  commissionAmount    Decimal        @db.Decimal(12, 2)  // profitAmount * (commissionRate / 100)

  // Payout tracking
  isPaid              Boolean        @default(false)
  paidAt              DateTime?
  walletTransactionId String?        @unique

  createdAt           DateTime       @default(now())

  @@index([referralId])
  @@index([orderId])
  @@index([isPaid])
  @@map("referral_earnings")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model UserVerification {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  referralCodeId      String              @unique
  referralCode        ReferralCode        @relation(fields: [referralCodeId], references: [id])

  // Verification documents
  idCardUrl           String?
  photoUrl            String?
  phoneNumber         String
  phoneVerified       Boolean             @default(false)
  phoneVerifiedAt     DateTime?

  // Admin review
  status              VerificationStatus  @default(PENDING)
  reviewedBy          String?
  reviewedAt          DateTime?
  rejectionReason     String?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@map("user_verifications")
}

// ========================================
// CUSTOMER RELIABILITY & RED FLAGS
// ========================================

model CustomerReliability {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Red flags tracking
  redFlagsCount           Int                @default(0)
  requiresPrepayment      Boolean            @default(false)
  prepaymentSince         DateTime?

  // Positive tracking
  successfulOrdersCount   Int                @default(0)
  totalOrdersCount        Int                @default(0)
  reliabilityScore        Decimal            @default(100) @db.Decimal(5, 2) // 0-100

  // Redemption tracking (to unlock referral account)
  referralsNeeded         Int                @default(0)  // How many refs needed to redeem
  redemptionReferrals     Int                @default(0)  // How many refs done for redemption
  isRedeemed              Boolean            @default(false)

  // Relationships
  incidents               RedFlagIncident[]

  lastIncidentAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([userId])
  @@index([requiresPrepayment])
  @@map("customer_reliability")
}

enum RedFlagReason {
  NO_SHOW_PICKUP       // Didn't show up to collect
  NO_PAYMENT           // Refused to pay after collection
  CANCELLED_LATE       // Cancelled after you already collected from farmer
  UNREACHABLE          // Couldn't contact after multiple attempts
  FRAUDULENT_ACTIVITY  // Suspected fraud
  OTHER
}

model RedFlagIncident {
  id                      String                @id @default(cuid())

  customerReliabilityId   String
  customerReliability     CustomerReliability   @relation(fields: [customerReliabilityId], references: [id], onDelete: Cascade)

  userId                  String
  user                    User                  @relation(fields: [userId], references: [id])

  orderId                 String?
  order                   FarmOrder?            @relation(fields: [orderId], references: [id])

  reason                  RedFlagReason
  description             String

  // Admin notes
  createdBy               String
  adminNotes              String?

  // Can be cleared if customer redeems themselves
  isCleared               Boolean               @default(false)
  clearedAt               DateTime?
  clearedBy               String?

  createdAt               DateTime              @default(now())

  @@index([userId])
  @@index([customerReliabilityId])
  @@map("red_flag_incidents")
}

// ========================================
// PAYMENT INTEGRATION
// ========================================

enum PaymentProvider {
  CASH
  MTN_MOMO
  ORANGE_MOMO
  WALLET
  PAYWITHCAMSOL
}

enum PaymentIntegrationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model PaymentTransaction {
  id                    String                     @id @default(cuid())

  // Links
  orderId               String?
  order                 FarmOrder?                 @relation(fields: [orderId], references: [id])

  walletTransactionId   String?                    @unique

  userId                String
  user                  User                       @relation(fields: [userId], references: [id])

  // Payment details
  provider              PaymentProvider
  amount                Decimal                    @db.Decimal(12, 2)
  currency              String                     @default("XAF")

  // External reference (from PayWithCamsol, MoMo, etc.)
  externalReference     String?                    @unique
  providerResponse      Json?

  status                PaymentIntegrationStatus   @default(PENDING)

  // Metadata
  metadata              Json?
  notes                 String?

  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  completedAt           DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([externalReference])
  @@map("payment_transactions")
}

// ========================================
// DISTRIBUTION - RESTAURANTS
// ========================================

enum RestaurantType {
  CLASSICAL_FINE_DINING
  CAFETERIA
  QUICK_SERVICE
}

enum RestaurantStatus {
  OPEN
  CLOSED
  TEMPORARILY_CLOSED
}

model Restaurant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  type        RestaurantType
  description String?
  address     String
  city        String
  state       String
  postalCode  String
  phone       String
  email       String
  status      RestaurantStatus @default(CLOSED)

  // Operating Hours
  openingTime   String? // e.g., "11:00"
  closingTime   String? // e.g., "22:00"
  operatingDays String? // JSON array of days

  capacity Int   @default(0)
  rating   Float @default(0)

  // Phase 1: Location details
  latitude              Float?
  longitude             Float?
  images                String[] // Array of image URLs
  amenities             String[] // parking, wifi, outdoor seating, etc.
  parkingInfo           String?
  accessibilityFeatures String[] // wheelchair, braille menu, etc.
  privateRooms          Boolean  @default(false)
  outdoorSeating        Boolean  @default(false)
  currentWaitTime       Int? // in minutes

  // Phase 1: About/Story
  story              String? // Restaurant history
  chefBios           Json? // Array of chef profiles
  awards             String[] // Awards and recognition
  sustainabilityInfo String? // Sustainability practices
  pressMedia         Json? // Press coverage links

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-branch support
  parentRestaurantId String? // For multi-branch chains
  isMainBranch       Boolean @default(false)
  branchCode         String? @unique // e.g., "NYC-001", "LA-001"

  // Relations
  menuCategories MenuCategory[]
  reservations   Reservation[]
  tables         Table[]
  orders         Order[]

  // Multi-branch relations
  parentRestaurant Restaurant?  @relation("BranchHierarchy", fields: [parentRestaurantId], references: [id])
  branches         Restaurant[] @relation("BranchHierarchy")

  // Location-specific resources
  staff     Staff[]
  inventory InventoryItem[]
  equipment Equipment[]

  @@map("restaurants")
}

model Table {
  id           String  @id @default(cuid())
  restaurantId String
  tableNumber  String
  capacity     Int
  isAvailable  Boolean @default(true)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, tableNumber])
  @@map("tables")
}

model MenuCategory {
  id           String  @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Float
  salePrice   Float? // For promotional pricing
  image       String?
  images      String[] // Multiple images for gallery
  isAvailable Boolean  @default(true)

  // Phase 1: Dietary information
  isVegetarian Boolean @default(false)
  isVegan      Boolean @default(false)
  isGlutenFree Boolean @default(false)
  isKeto       Boolean @default(false)
  isHalal      Boolean @default(false)
  isKosher     Boolean @default(false)

  // Phase 1: Enhanced details
  calories        Int?
  nutritionInfo   Json? // Nutritional information: protein, carbs, fat, fiber, sodium, sugar
  preparationTime Int? // in minutes
  spiceLevel      Int? // 0-5 scale
  allergens       String[] // gluten, dairy, nuts, shellfish, etc.
  ingredients     String? // Comma-separated or JSON

  // Phase 1: Marketing
  winePairing       String? // Suggested wine/drink pairing
  isChefRecommended Boolean @default(false)
  isSeasonal        Boolean @default(false)
  isPopular         Boolean @default(false)

  // Phase 1: Customer ratings
  averageRating Decimal? @default(0)
  reviewCount   Int      @default(0)

  // Phase 1: Customization options
  customizationOptions Json? // JSON object for modifiers

  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  recipe     Recipe? // One-to-one relationship with Recipe

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("menu_items")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id           String  @id @default(cuid())
  restaurantId String
  userId       String
  tableId      String?

  reservationDate DateTime
  reservationTime String // e.g., "19:00"
  partySize       Int
  status          ReservationStatus @default(PENDING)

  specialRequests String?
  notes           String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  table      Table?     @relation(fields: [tableId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservations")
}

// ========================================
// DISTRIBUTION - E-COMMERCE / RETAIL
// ========================================

enum ProductCategory {
  FRESH_PRODUCE
  DAIRY
  MEAT
  SEAFOOD
  POULTRY
  PROCESSED_FOODS
  BEVERAGES
  BAKERY
  FROZEN
  PANTRY
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  COMING_SOON
}

model Product {
  id          String          @id @default(cuid())
  sku         String          @unique
  name        String
  slug        String          @unique
  description String?
  category    ProductCategory
  status      ProductStatus   @default(ACTIVE)

  price     Float
  salePrice Float?
  cost      Float? // For margin calculation

  // Inventory
  stockQuantity     Int @default(0)
  lowStockThreshold Int @default(10)

  // Product Details
  unit       String // kg, lbs, piece, etc.
  weight     Float?
  dimensions String? // JSON: {length, width, height}

  // Images
  images    String[] // Array of image URLs
  thumbnail String?

  // Traceability
  farmSource         String?
  processingLocation String?
  harvestDate        DateTime?
  expiryDate         DateTime?

  // SEO & Marketing
  metaTitle       String?
  metaDescription String?
  tags            String[]

  isOrganic  Boolean @default(false)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@map("products")
}

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderType {
  DINE_IN // Customer is at restaurant, food served to table
  TAKEAWAY // Customer picks up from restaurant
  DELIVERY // Food delivered to customer address
  ONLINE_RETAIL // E-commerce retail products
  B2B_WHOLESALE // Partner orders
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  DIGITAL_WALLET
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  userId       String
  restaurantId String? // Required for DINE_IN, TAKEAWAY, DELIVERY
  waiterId     String? // Staff member who served the order
  type         OrderType
  status       OrderStatus @default(PENDING)

  // Payment
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  // Amounts
  subtotal    Float
  tax         Float @default(0)
  shippingFee Float @default(0)
  discount    Float @default(0)
  total       Float

  // Dine-in specific
  tableNumber String? // For DINE_IN orders

  // Delivery/Shipping
  deliveryAddress String? // For DELIVERY orders
  shippingAddress String? // For ONLINE_RETAIL orders
  trackingNumber  String?

  // Pickup details
  pickupTime DateTime? // Scheduled pickup time for TAKEAWAY

  // Customer details (for restaurant orders)
  customerName String? // Customer name for the order
  phoneNumber  String? // Customer phone for order updates

  // Metadata
  notes         String?
  customerNotes String?

  user        User              @relation(fields: [userId], references: [id])
  restaurant  Restaurant?       @relation(fields: [restaurantId], references: [id])
  waiter      Staff?            @relation("WaiterAssignments", fields: [waiterId], references: [id])
  items       OrderItem[]
  preparation OrderPreparation?
  delivery    Delivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
  @@index([restaurantId])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String? // For retail orders
  menuItemId String? // For restaurant orders

  quantity Int
  price    Float // Price at time of order

  // Customizations (e.g., "no salt", "extra chocolate")
  // JSON: { "removed": ["salt"], "added": ["chocolate"], "notes": "less spicy" }
  customizations Json?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model Review {
  id         String  @id @default(cuid())
  userId     String
  productId  String
  rating     Int // 1-5
  title      String?
  comment    String?
  isVerified Boolean @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

// ========================================
// PROCESSING
// ========================================

enum ProcessingType {
  SARDINE
  MILK
  MEAT
  VEGETABLE
  FRUIT
  GRAIN
}

model ProcessingFacility {
  id       String         @id @default(cuid())
  name     String
  type     ProcessingType
  location String
  capacity Float // tons per day
  status   String // OPERATIONAL, MAINTENANCE, CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("processing_facilities")
}

// ========================================
// FARMING
// ========================================

enum FarmType {
  AQUACULTURE // Fish farming
  POULTRY
  LIVESTOCK
  CROPS
}

model Farm {
  id       String   @id @default(cuid())
  name     String
  type     FarmType
  location String
  size     Float // in acres
  status   String // ACTIVE, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("farms")
}

// ========================================
// INVENTORY MANAGEMENT
// ========================================

enum InventoryUnit {
  KG // Kilograms
  G // Grams
  L // Liters
  ML // Milliliters
  PCS // Pieces
  DOZEN
  LBS // Pounds
  OZ // Ounces
  CUPS
  TBSP // Tablespoons
  TSP // Teaspoons
}

enum InventoryCategory {
  FLOUR_GRAIN // Flour, wheat, rice, etc.
  SUGAR_SWEETENER // Sugar, honey, syrup
  DAIRY // Milk, butter, cheese, cream
  EGGS
  OILS_FATS // Cooking oil, butter, lard
  SPICES_HERBS
  VEGETABLES
  FRUITS
  MEAT
  SEAFOOD
  POULTRY
  CHOCOLATE_COCOA
  NUTS_SEEDS
  BAKING_SUPPLIES // Baking powder, yeast, vanilla
  CONDIMENTS
  BEVERAGES
  CANNED_GOODS
  FROZEN
  OTHER
}

model InventoryItem {
  id           String            @id @default(cuid())
  restaurantId String? // Location-specific inventory (nullable for migration)
  name         String
  category     String // Flexible category - can be custom or from predefined list
  unit         InventoryUnit

  // THREE-STATE STOCK TRACKING
  rawStock       Float @default(0) // Available for use/preparation
  wipStock       Float @default(0) // Locked in pre-prepared items
  consumedStock  Float @default(0) // Served to customers (historical)
  totalPurchased Float @default(0) // All-time purchases for tracking

  minimumStock    Float  @default(0) // Alert when raw stock below this
  maximumStock    Float? // Optional max capacity
  reorderPoint    Float? // Automatic reorder trigger
  reorderQuantity Float? // How much to reorder

  // Compound/Pre-prepared ingredient tracking
  isCompound          Boolean @default(false) // Is this a pre-prepared item?
  preparationRecipeId String? @unique // Link to preparation recipe if compound

  // Pricing
  costPerUnit Float? // Cost price
  supplier    String?

  // Storage & expiry
  storageLocation String? // Pantry, Fridge, Freezer
  expiryDate      DateTime?
  batchNumber     String?

  // Metadata
  description String?
  notes       String?
  imageUrl    String? // Image of the ingredient
  size        String? // Size/grade: SMALL, MEDIUM, LARGE, EXTRA_LARGE, JUMBO (universal for all ingredients)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurant         Restaurant?              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeIngredients  RecipeIngredient[]
  stockMovements     StockMovement[]
  preparationRecipe  PreparationRecipe?       @relation("OutputItem")
  usedInPreparations PreparationRecipeInput[]

  @@map("inventory_items")
}

model Recipe {
  id          String @id @default(cuid())
  menuItemId  String @unique
  name        String
  servingSize Int    @default(1) // Number of servings this recipe makes

  instructions String? // Cooking instructions
  prepTime     Int? // in minutes
  cookTime     Int? // in minutes

  // Cost calculation
  totalCost      Float? // Auto-calculated from ingredients
  costPerServing Float?

  // Nutritional Information (per serving)
  calories Int? // Calories per serving
  protein  String? // Protein in grams
  carbs    String? // Carbohydrates in grams
  fat      String? // Fat in grams
  fiber    String? // Fiber in grams
  sodium   String? // Sodium in mg
  sugar    String? // Sugar in grams

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id              String @id @default(cuid())
  recipeId        String
  inventoryItemId String

  quantity Float // Amount needed
  unit     InventoryUnit

  notes String? // e.g., "chopped", "melted", "optional"

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, inventoryItemId])
  @@map("recipe_ingredients")
}

enum StockMovementType {
  PURCHASE // Buying new stock (affects RAW)
  PRODUCTION // Raw → WIP (bulk preparation)
  USAGE // WIP → Consumed (order served)
  WASTE // Spoiled/damaged
  ADJUSTMENT // Manual correction
  RETURN // Returned to supplier
  TRANSFER // Moved between locations
}

model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMovementType

  quantity Float
  unit     InventoryUnit

  // Track which state is affected
  affectedState String // "RAW", "WIP", or "CONSUMED"

  // Snapshot of all three states before and after
  previousRaw      Float?
  newRaw           Float?
  previousWip      Float?
  newWip           Float?
  previousConsumed Float?
  newConsumed      Float?

  // Reference
  referenceType String? // e.g., "PreparationBatch", "Order", "Purchase"
  referenceId   String? // Batch ID, Order ID, etc.

  // Details
  reason      String?
  notes       String?
  performedBy String? // User ID

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_movements")
}

// Preparation Recipe: Defines how to make a compound/pre-prepared ingredient
// Example: "Pre-boiled Salted Beans" = Beans (raw) + Salt (raw) + Water
model PreparationRecipe {
  id   String @id @default(cuid())
  name String

  // Output: The compound ingredient this recipe creates
  outputItemId   String        @unique
  outputQuantity Float // How much is produced per batch
  outputUnit     InventoryUnit

  // Preparation details
  prepTime        Int? // in minutes
  instructions    String?
  storageLocation String? // Where to store prepared item
  shelfLifeDays   Int? // How long it lasts

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  outputItem InventoryItem            @relation("OutputItem", fields: [outputItemId], references: [id])
  inputs     PreparationRecipeInput[]
  batches    PreparationBatch[]

  @@map("preparation_recipes")
}

// Inputs for a preparation recipe (raw ingredients)
model PreparationRecipeInput {
  id                  String @id @default(cuid())
  preparationRecipeId String
  inventoryItemId     String

  quantity Float
  unit     InventoryUnit

  notes String? // e.g., "rinsed", "soaked overnight"

  preparationRecipe PreparationRecipe @relation(fields: [preparationRecipeId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([preparationRecipeId, inventoryItemId])
  @@map("preparation_recipe_inputs")
}

// Individual batch of prepared ingredients
// Tracks exactly what raw ingredients were used and how much is left
model PreparationBatch {
  id                  String @id @default(cuid())
  preparationRecipeId String
  batchNumber         String @unique

  quantityProduced  Float // Total amount made
  quantityRemaining Float // How much is left (WIP)
  quantityConsumed  Float @default(0) // How much was used (moved to CONSUMED)

  // JSON snapshot of exactly what raw ingredients were used
  // Example: { "salt": { "quantity": 50, "unit": "G" }, "beans": { "quantity": 2, "unit": "KG" } }
  ingredientsUsed Json

  productionDate DateTime  @default(now())
  expiryDate     DateTime? // Based on shelfLifeDays

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preparationRecipe PreparationRecipe @relation(fields: [preparationRecipeId], references: [id])

  @@map("preparation_batches")
}

// ========================================
// STAFF MANAGEMENT
// ========================================

enum StaffRole {
  CHEF
  SOUS_CHEF
  LINE_COOK
  WAITER
  HOST
  DELIVERY_DRIVER
  MANAGER
  CASHIER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

model Staff {
  id           String      @id @default(cuid())
  userId       String      @unique // Link to User table
  restaurantId String // Which branch they work at
  role         StaffRole
  status       StaffStatus @default(ACTIVE)

  // Employment details
  employeeId      String    @unique
  hireDate        DateTime
  terminationDate DateTime?
  hourlyRate      Float?
  salary          Float?

  // Work schedule
  workSchedule Json? // { "monday": ["09:00-17:00"], "tuesday": ["09:00-17:00"] }

  // Performance tracking
  ordersCompleted     Int   @default(0) // For chefs/waiters
  deliveriesCompleted Int   @default(0) // For delivery drivers
  averageRating       Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Relations
  ordersAsChef   OrderPreparation[] @relation("ChefAssignments")
  ordersAsWaiter Order[]            @relation("WaiterAssignments")
  deliveries     Delivery[]

  @@map("staff")
}

// ========================================
// EQUIPMENT & MAINTENANCE
// ========================================

enum EquipmentType {
  COOKING_APPLIANCE // Oven, stove, grill
  REFRIGERATION // Fridge, freezer, walk-in
  FOOD_PREP // Blender, mixer, food processor
  DISHWASHING // Dishwasher
  MEASUREMENT // Scale, thermometer
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  MAINTENANCE_REQUIRED
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Equipment {
  id           String          @id @default(cuid())
  restaurantId String
  name         String
  type         EquipmentType
  status       EquipmentStatus @default(OPERATIONAL)

  // Details
  manufacturer   String?
  model          String?
  serialNumber   String?
  purchaseDate   DateTime?
  purchasePrice  Float?
  warrantyExpiry DateTime?

  // Maintenance
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  maintenanceCostBudget Float? // Allocated budget for maintenance

  // Usage tracking
  totalUsageHours Float @default(0)
  usageCount      Int   @default(0) // Number of times used

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  maintenanceLogs MaintenanceLog[]
  usageLogs       EquipmentUsageLog[]

  @@map("equipment")
}

model MaintenanceLog {
  id          String @id @default(cuid())
  equipmentId String

  maintenanceType String // ROUTINE, REPAIR, EMERGENCY, INSPECTION
  description     String
  cost            Float
  performedBy     String? // Technician name or company
  performedById   String? // Staff ID if internal

  startDate     DateTime
  completedDate DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

model EquipmentUsageLog {
  id          String  @id @default(cuid())
  equipmentId String
  orderId     String? // Link to order if applicable
  recipeId    String? // Link to recipe

  usedAt          DateTime @default(now())
  durationMinutes Int? // How long it was used

  notes String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_usage_logs")
}

// ========================================
// DELIVERY & TRACKING
// ========================================

enum DeliveryStatus {
  ASSIGNED // Assigned to driver
  PICKED_UP // Driver picked up from restaurant
  IN_TRANSIT // On the way to customer
  ARRIVED // Driver arrived at location
  DELIVERED // Successfully delivered
  FAILED // Failed delivery attempt
  CANCELLED
}

model Delivery {
  id       String         @id @default(cuid())
  orderId  String         @unique
  driverId String
  status   DeliveryStatus @default(ASSIGNED)

  // Tracking
  assignedAt  DateTime  @default(now())
  pickedUpAt  DateTime?
  inTransitAt DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  // Location tracking (store last known coordinates)
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?

  // Delivery details
  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  deliveryNotes         String?

  // Payment tracking
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  paymentMethod   String? // CASH, CARD, ONLINE
  amountCollected Float?

  // Failed delivery tracking
  failureReason String?
  failureNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Staff @relation(fields: [driverId], references: [id])

  locationHistory DeliveryLocationHistory[]

  @@map("deliveries")
}

model DeliveryLocationHistory {
  id         String @id @default(cuid())
  deliveryId String

  latitude  Float
  longitude Float
  timestamp DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_location_history")
}

// ========================================
// ORDER PREPARATION & KITCHEN WORKFLOW
// ========================================

enum PreparationStatus {
  PENDING // Order received, not started
  PREPARING // Chef is cooking
  READY // Food is ready
  SERVED // Served to customer (dine-in) or picked up
}

model OrderPreparation {
  id      String            @id @default(cuid())
  orderId String            @unique
  chefId  String?
  status  PreparationStatus @default(PENDING)

  // Timeline
  startedAt DateTime?
  readyAt   DateTime?
  servedAt  DateTime?

  // Photo updates during preparation
  photos String[] // Array of image URLs

  // Notes
  chefNotes    String?
  kitchenNotes String?

  // Estimated time
  estimatedReadyTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  chef  Staff? @relation("ChefAssignments", fields: [chefId], references: [id])

  @@map("order_preparations")
}

// ========================================
// ANALYTICS & REPORTING
// ========================================

model ActivityLog {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@map("activity_logs")
}

// ============================================
// DELIVERY ZONES
// ============================================

model DeliveryZone {
  id              String              @id @default(cuid())

  name            String              @unique // "Zone 1 - Central Buea"
  description     String?
  deliveryFee     Decimal             @db.Decimal(10, 2)

  // Geographic data
  areas           DeliveryZoneArea[]

  isActive        Boolean             @default(true)

  // Relationships
  orders          FarmOrder[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([isActive])
  @@map("delivery_zones")
}

model DeliveryZoneArea {
  id                String         @id @default(cuid())
  zoneId            String
  zone              DeliveryZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  areaName          String         // "Molyko", "Great Soppo", etc.

  createdAt         DateTime       @default(now())

  @@unique([zoneId, areaName])
  @@index([zoneId])
  @@map("delivery_zone_areas")
}

// ============================================
// FARM PRODUCTS DISTRIBUTION
// ============================================

enum FarmProductCategory {
  LEAFY_GREENS // Spinach, lettuce, kale
  ROOT_VEGETABLES // Carrots, potatoes, yams, cassava
  FRUITS // Bananas, mangoes, oranges
  LEGUMES // Beans, peas, lentils
  GRAINS_CEREALS // Rice, corn, wheat
  SEEDS_NUTS // Groundnuts, sesame
  TUBERS // Yam, cocoyam, sweet potato
  HERBS_SPICES // Ginger, garlic, pepper
  FRESH_VEGETABLES // Tomatoes, peppers, onions
  DAIRY_EGGS // Fresh milk, eggs (from farms)
  LIVESTOCK_MEAT // Fresh meat
  FISH_SEAFOOD // Fresh fish
}

enum PriceType {
  RETAIL_ONLY // Only sold by weight/volume
  BULK_ONLY // Only sold in bags/crates
  BOTH // Available in both retail and bulk
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
  BOOKABLE         // Out of stock but accepting pre-orders
}

enum FarmProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

model FarmProduct {
  id          String              @id @default(cuid())
  sku         String              @unique
  slug        String              @unique
  name        String
  description String?
  category    FarmProductCategory
  subcategory String?

  // Images (admin uploads)
  images    String[] // URLs to uploaded images
  thumbnail String? // Primary image

  // Pricing Configuration
  priceType PriceType @default(RETAIL_ONLY)

  // Farm cost (what we pay the farmer)
  farmCostRetail Decimal? @db.Decimal(10, 2) // Cost per retail unit from farmer
  farmCostBulk   Decimal? @db.Decimal(10, 2) // Cost per bulk unit from farmer

  // Retail pricing (sold by weight/volume) - AUTO-CALCULATED as farmCost * 1.4
  retailPrice  Decimal? // Price per unit (XAF)
  retailUnit   String? // kg, g, L, ml, pieces
  retailMinQty Decimal? // Minimum purchase quantity

  // Bulk pricing (sold in bags/crates) - AUTO-CALCULATED as farmCost * 1.4
  bulkPrice       Decimal? // Price per bag/crate (XAF)
  bulkUnit        String? // "25kg bag", "50kg sack", "crate"
  bulkQtyPerUnit  Decimal? // How much in each unit (25, 50, etc.)
  bulkMinOrder    Int? // Minimum number of bags/crates

  // NEW: Booking & Pricing for out-of-stock items
  stockStatus       StockStatus @default(OUT_OF_STOCK)
  isBookable        Boolean     @default(false)

  // Price range for bookable items (when exact price unknown)
  priceMin          Decimal?    @db.Decimal(10, 2)
  priceMax          Decimal?    @db.Decimal(10, 2)
  priceUnit         String?     // "per kg", "per bag", etc.

  // Confirmed price (after farm visit)
  confirmedPrice    Decimal?    @db.Decimal(10, 2)
  confirmedAt       DateTime?
  confirmedBy       String?

  // Seasonal info
  seasonStartMonth  Int?        // 1-12
  seasonEndMonth    Int?        // 1-12

  // Inventory - Pre-Order System
  stockQuantity      Decimal @default(0) // Total available (in base unit)
  preOrderedQuantity Decimal @default(0) // Total pre-ordered (reserved)
  availableQuantity  Decimal @default(0) // stockQuantity - preOrderedQuantity
  stockUnit          String // Base unit (kg, L, pieces)
  lowStockThreshold  Decimal?
  reorderPoint       Decimal?

  // Traceability
  farmSource  String? // Farm name/location (legacy - use farmer relationship instead)
  farmerId    String? // Link to Farmer
  farmer      Farmer? @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  harvestDate DateTime?
  expiryDate  DateTime?
  batchNumber String?

  // Product attributes
  isOrganic   Boolean @default(false)
  isCertified Boolean @default(false)
  isInSeason  Boolean @default(true)
  isFeatured  Boolean @default(false)

  // Measurements
  weight     Decimal? // Product weight
  weightUnit String? // kg, g
  dimensions String? // LxWxH in cm

  // SEO
  metaTitle       String?
  metaDescription String?
  keywords        String[]

  // Status
  status      FarmProductStatus @default(ACTIVE)
  isAvailable Boolean           @default(true)

  // NEW: Bulk discount tiers
  bulkDiscounts BulkDiscount[]

  // Relationships
  cartItems      FarmCartItem[]
  orderItems     FarmOrderItem[]
  reviews        FarmProductReview[]
  restockHistory StockRestock[]
  supplies       FarmSupply[] // Supplies from farmers

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([slug])
  @@index([stockStatus])
  @@map("farm_products")
}

model BulkDiscount {
  id                String       @id @default(cuid())
  productId         String
  product           FarmProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQuantity       Decimal      @db.Decimal(10, 2)  // e.g., 50kg
  discountPercent   Decimal      @db.Decimal(5, 2)   // e.g., 10% off

  isActive          Boolean      @default(true)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([productId])
  @@map("bulk_discounts")
}

// ============================================
// FARM PRODUCT CART
// ============================================

model FarmCart {
  id        String   @id @default(cuid())
  userId    String? // Null for guest carts
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // For guest users
  items     FarmCartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // Cart expiry (7 days)

  @@index([userId])
  @@index([sessionId])
  @@map("farm_carts")
}

enum PurchaseType {
  RETAIL // Buying by weight/volume
  BULK // Buying in bags/crates
}

model FarmCartItem {
  id     String   @id @default(cuid())
  cartId String
  cart   FarmCart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   FarmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Quantity & Pricing
  purchaseType PurchaseType // RETAIL or BULK
  quantity     Decimal // Amount ordered
  unit         String // Unit of measurement
  pricePerUnit Decimal // Price at time of adding (XAF)
  totalPrice   Decimal // quantity * pricePerUnit (XAF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("farm_cart_items")
}

// ============================================
// FARM PRODUCT ORDERS
// ============================================

enum FulfillmentType {
  PICKUP // Customer picks up
  DELIVERY // We deliver
}

enum FarmPaymentMethod {
  MOBILE_MONEY // MTN, Orange, etc.
  BANK_CARD // Credit/Debit card
  BANK_TRANSFER
  CASH_ON_PICKUP
  CASH_ON_DELIVERY
}

enum FarmPaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum FarmOrderType {
  REGULAR          // Normal in-stock purchase
  BOOKING          // Pre-order for out-of-stock item
}

enum BookingStatus {
  PENDING_PRICE    // Waiting for you to visit farm & confirm price
  PRICE_CONFIRMED  // You confirmed price, waiting for customer approval
  CUSTOMER_APPROVED // Customer approved price, order locked
  CUSTOMER_DECLINED // Customer declined price
  COLLECTED        // You collected from farmer
  READY_PICKUP     // Stock arrived, ready for customer pickup/delivery
  COMPLETED        // Customer collected
  CANCELLED
}

enum FarmOrderStatus {
  PENDING // Just placed
  CONFIRMED // Admin confirmed
  PREPARING // Being prepared
  READY_FOR_PICKUP // Ready for customer pickup
  OUT_FOR_DELIVERY // In transit
  DELIVERED // Completed
  COMPLETED // Picked up or delivered
  CANCELLED // Cancelled
}

model FarmOrder {
  id          String   @id @default(cuid())
  orderNumber String   @unique // FPO-2026-XXXXX

  // Customer Info
  userId  String? // Null for guest orders
  user    User?   @relation(fields: [userId], references: [id])
  isGuest Boolean @default(false)

  // Guest customer details
  guestEmail String?
  guestPhone String?
  guestName  String?

  // Order Details
  items            FarmOrderItem[]
  totalAmount      Decimal // Total (XAF)
  subtotal         Decimal // Before delivery (XAF)
  deliveryFee      Decimal @default(0) // Delivery cost (XAF)
  discount         Decimal @default(0) // Any discounts (XAF)
  referralDiscount Decimal @default(0) @db.Decimal(12, 2) // 5% discount when using referral code

  // NEW: Booking system
  orderType            FarmOrderType       @default(REGULAR)
  bookingStatus        BookingStatus?

  // Pricing
  estimatedTotal       Decimal?            @db.Decimal(12, 2)  // Initial estimate
  confirmedTotal       Decimal?            @db.Decimal(12, 2)  // After farm visit

  // Payment tracking
  depositAmount        Decimal             @default(0) @db.Decimal(12, 2)
  amountPaid           Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue           Decimal             @default(0) @db.Decimal(12, 2)

  // Wallet integration
  paidFromWallet       Decimal             @default(0) @db.Decimal(12, 2)
  paidCash             Decimal             @default(0) @db.Decimal(12, 2)
  paidMomo             Decimal             @default(0) @db.Decimal(12, 2)

  // Cost tracking (for referral commission calculation)
  costPrice            Decimal?            @db.Decimal(12, 2)  // What you paid farmers
  transportCost        Decimal?            @db.Decimal(12, 2)
  totalCost            Decimal?            @db.Decimal(12, 2)  // costPrice + transportCost
  profitAmount         Decimal?            @db.Decimal(12, 2)  // confirmedTotal - totalCost

  // Price confirmation tracking
  priceConfirmedAt     DateTime?
  priceConfirmedBy     String?
  customerApprovedAt   DateTime?

  // Fulfillment
  fulfillmentType FulfillmentType

  // Pickup details
  pickupLocation String?
  pickupDate     DateTime?
  pickupTime     String?

  // Delivery details
  deliveryAddress      String?
  deliveryCity         String?
  deliveryState        String?
  deliveryPhone        String?
  deliveryInstructions String?
  estimatedDelivery    DateTime?

  // GPS Coordinates for delivery location
  deliveryLatitude     Float?
  deliveryLongitude    Float?

  // NEW: Delivery zone
  deliveryZoneId       String?
  deliveryZone         DeliveryZone?       @relation(fields: [deliveryZoneId], references: [id])

  // Payment
  paymentMethod    FarmPaymentMethod
  paymentStatus    FarmPaymentStatus @default(PENDING)
  paymentReference String? // PayWithCamsol transaction ref
  paymentDetails   Json? // Store payment gateway response
  paidAt           DateTime?

  // Order Status
  status        FarmOrderStatus              @default(PENDING)
  statusHistory FarmOrderStatusHistory[]

  // NEW: Referral tracking
  referredById        String?
  referredBy          User?               @relation("ReferredOrders", fields: [referredById], references: [id])
  referralEarnings    ReferralEarning[]

  // NEW: Payment transactions
  paymentTransactions PaymentTransaction[]

  // NEW: Receipt
  receipt             Receipt?

  // NEW: Red flag tracking
  redFlagIncidents    RedFlagIncident[]

  // NEW: Notifications & Receipts
  notifications       OrderNotification[]
  orderReceipt        OrderReceipt?
  financialTransactions FinancialTransaction[]

  // Notes
  customerNotes String?
  adminNotes    String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderType])
  @@index([bookingStatus])
  @@index([deliveryZoneId])
  @@map("farm_orders")
}

model FarmOrderItem {
  id      String    @id @default(cuid())
  orderId String
  order   FarmOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   FarmProduct @relation(fields: [productId], references: [id])

  // Product snapshot at time of order
  productName  String
  productSku   String
  productImage String?

  // Pricing
  purchaseType   PurchaseType
  quantity       Decimal
  unit           String
  pricePerUnit   Decimal // XAF (customer pays)
  totalPrice     Decimal // XAF (customer pays)

  // Cost tracking (for profit calculation)
  farmCostPerUnit Decimal? @db.Decimal(10, 2) // What we paid farmer per unit
  farmCostTotal   Decimal? @db.Decimal(10, 2) // farmCostPerUnit * quantity

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("farm_order_items")
}

model FarmOrderStatusHistory {
  id        String          @id @default(cuid())
  orderId   String
  order     FarmOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    FarmOrderStatus
  note      String?
  updatedBy String? // Admin user ID
  timestamp DateTime        @default(now())

  @@index([orderId])
  @@map("farm_order_status_history")
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model FarmProductReview {
  id        String      @id @default(cuid())
  productId String
  product   FarmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating             Int     // 1-5 stars
  title              String?
  comment            String?
  isVerifiedPurchase Boolean @default(false)

  // Moderation
  isApproved  Boolean   @default(false)
  moderatedBy String?
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("farm_product_reviews")
}

// ============================================
// RECEIPTS
// ============================================

model Receipt {
  id                String       @id @default(cuid())
  orderId           String       @unique
  order             FarmOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  receiptNumber     String       @unique  // e.g., "SF-2024-001234"
  pdfUrl            String?

  issuedAt          DateTime     @default(now())
  issuedBy          String
  issuedToUserId    String

  // Delivery method
  sentViaEmail      Boolean      @default(false)
  sentViaWhatsapp   Boolean      @default(false)
  printed           Boolean      @default(false)

  createdAt         DateTime     @default(now())

  @@index([orderId])
  @@index([receiptNumber])
  @@map("receipts")
}

// ============================================
// STOCK RESTOCK SYSTEM (PRE-ORDER)
// ============================================

model StockRestock {
  id              String       @id @default(cuid())
  productId       String
  product         FarmProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity        Decimal      @db.Decimal(10, 2) // Quantity restocked
  preOrdersFilled Decimal      @db.Decimal(10, 2) // Pre-orders fulfilled from this restock
  remainingStock  Decimal      @db.Decimal(10, 2) // Stock remaining after pre-orders

  farmCost        Decimal?     @db.Decimal(10, 2) // Cost per unit from farmer
  totalCost       Decimal?     @db.Decimal(10, 2) // Total cost of restock

  supplier        String?      // Farmer/supplier name
  restockedBy     String?      // Admin user ID
  restockedAt     DateTime     @default(now())
  notes           String?

  createdAt       DateTime     @default(now())

  @@index([productId])
  @@index([restockedAt])
  @@map("stock_restocks")
}

// ============================================
// ORDER NOTIFICATION SYSTEM
// ============================================

model OrderNotification {
  id            String     @id @default(cuid())
  orderId       String
  order         FarmOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  step          Int        // 1, 2, or 3
  template      String     // Message template
  message       String     // Actual message sent

  sentAt        DateTime?
  sentVia       String?    // "SMS" | "WHATSAPP" | "CALL" | "MANUAL"
  response      String?    // Customer response
  respondedAt   DateTime?

  createdAt     DateTime   @default(now())

  @@index([orderId])
  @@index([step])
  @@map("order_notifications")
}

model OrderReceipt {
  id            String     @id @default(cuid())
  orderId       String     @unique
  order         FarmOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  receiptNumber String     @unique // Format: RCP-YYYY-XXXXXX
  signatureData String?    // Base64 image
  signedBy      String     // Customer name
  signedAt      DateTime
  pdfUrl        String?

  createdAt     DateTime   @default(now())

  @@index([orderId])
  @@index([receiptNumber])
  @@map("order_receipts")
}

// ============================================
// FINANCIAL TRACKING SYSTEM
// ============================================

model FinancialTransaction {
  id              String    @id @default(cuid())
  type            String    // REVENUE, EXPENSE, COMMISSION, REFUND
  category        String    // PRODUCT_SALE, DELIVERY_FEE, REFERRAL_COMMISSION, FARM_PURCHASE, TRANSPORT_COST
  amount          Decimal   @db.Decimal(12, 2)

  orderId         String?
  order           FarmOrder? @relation(fields: [orderId], references: [id])
  referralId      String?

  description     String
  metadata        Json?     // Additional details

  recordedAt      DateTime  @default(now())
  recordedBy      String?   // Admin user ID

  @@index([type])
  @@index([category])
  @@index([orderId])
  @@index([recordedAt])
  @@map("financial_transactions")
}

model FinancialSummary {
  id               String    @id @default(cuid())
  date             DateTime  @unique // Daily summary

  totalRevenue     Decimal   @default(0) @db.Decimal(12, 2)
  totalExpenses    Decimal   @default(0) @db.Decimal(12, 2)
  totalCommissions Decimal   @default(0) @db.Decimal(12, 2)
  netProfit        Decimal   @default(0) @db.Decimal(12, 2)

  orderCount       Int       @default(0)

  updatedAt        DateTime  @updatedAt

  @@index([date])
  @@map("financial_summaries")
}

// ============================================
// FARMER MANAGEMENT
// ============================================

enum FarmerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum FarmerType {
  INDIVIDUAL      // Individual farmer
  COOPERATIVE     // Farmer cooperative
  COMMERCIAL_FARM // Commercial farming operation
  ORGANIC_FARM    // Certified organic farm
}

model Farmer {
  id String @id @default(cuid())

  // Basic Information
  name              String
  businessName      String? // For cooperatives/commercial farms
  farmerType        FarmerType @default(INDIVIDUAL)
  registrationNumber String?   @unique // Business registration number
  taxId             String?   @unique

  // Contact Information
  email       String?
  phone       String
  alternatePhone String?
  address     String
  region      String  // Bafoussam, Bamenda, Buea, etc.
  district    String?
  village     String?

  // GPS Location
  latitude  Float?
  longitude Float?
  gpsCoordinates String? // Formatted coordinates

  // Farm Details
  farmSize      Decimal? @db.Decimal(10, 2) // In hectares
  farmSizeUnit  String?  @default("hectares")
  mainCrops     String[] // ["Tomatoes", "Potatoes", "Beans"]

  // Certifications
  isOrganic       Boolean @default(false)
  isCertified     Boolean @default(false)
  certifications  String[] // ["Organic", "Fair Trade", etc.]
  certificationDocs String[] // URLs to certification documents

  // Financial Information
  bankName          String?
  bankAccountNumber String?
  mobileMoneyNumber String?
  mobileMoneyProvider String? // MTN, Orange

  // Performance Metrics
  totalSupplied     Decimal @default(0) @db.Decimal(10, 2) // Total kg/units supplied
  totalRevenue      Decimal @default(0) @db.Decimal(10, 2) // Total XAF earned
  averageQualityRating Decimal? @db.Decimal(3, 2) // 1.00-5.00
  onTimeDeliveryRate   Decimal? @db.Decimal(5, 2) // Percentage

  // Status & Verification
  status        FarmerStatus @default(PENDING_VERIFICATION)
  isVerified    Boolean      @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?      // Admin user ID

  // Notes
  notes         String? // Admin notes
  specialties   String? // What they're particularly good at growing

  // Relationships
  products      FarmProduct[] // Products supplied by this farmer
  supplies      FarmSupply[]  // Supply transactions/deliveries

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  // Admin user ID

  @@index([status])
  @@index([region])
  @@index([farmerType])
  @@index([phone])
  @@map("farmers")
}

// Track supplies/deliveries from farmers
model FarmSupply {
  id String @id @default(cuid())

  // Farmer & Product
  farmerId  String
  farmer    Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  productId String
  product   FarmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Supply Details
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  // kg, bags, crates
  pricePerUnit   Decimal @db.Decimal(10, 2) // Price paid to farmer per unit
  totalCost      Decimal @db.Decimal(10, 2) // Total amount paid to farmer

  // Quality Assessment
  qualityRating  Int?    // 1-5 stars
  qualityNotes   String?

  // Delivery Information
  deliveryDate   DateTime
  receivedDate   DateTime?
  receivedBy     String?  // Staff member who received it

  // Batch/Traceability
  batchNumber    String?
  harvestDate    DateTime?
  expiryDate     DateTime?

  // Payment
  paymentStatus  String   @default("PENDING") // PENDING, PAID, PARTIAL
  paidAmount     Decimal  @default(0) @db.Decimal(10, 2)
  paidAt         DateTime?
  paymentMethod  String?  // CASH, MOBILE_MONEY, BANK_TRANSFER
  paymentReference String?

  // Status
  status         String   @default("RECEIVED") // ORDERED, RECEIVED, QUALITY_CHECK, APPROVED, REJECTED
  notes          String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  // Admin user ID

  @@index([farmerId])
  @@index([productId])
  @@index([deliveryDate])
  @@index([status])
  @@map("farm_supplies")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfiguration {
  id          String    @id @default(cuid())
  key         String    @unique // "TRANSPORT_COST_PERCENTAGE", "REFERRAL_COMMISSION_RATE"
  value       String    // JSON string
  description String?

  updatedAt   DateTime  @updatedAt
  updatedBy   String?   // Admin user ID

  @@index([key])
  @@map("system_configurations")
}
